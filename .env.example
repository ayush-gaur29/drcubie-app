# ==============================================================================
# Dr. Cubie Inspiration - Public Frontend Environment Variables (.env)
# ==============================================================================
# NOTE: Only browser-safe public/anon keys belong here.
# NEVER put Firebase service-account JSON, private keys, or Stripe secret keys here!
# ==============================================================================

# Supabase Public API Configuration
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# Stripe Public Publishable Key (for client-side Elements)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# Optional: Firebase Client Configuration (Public Web/Client IDs only)
# Native Android and iOS use google-services.json and GoogleService-Info.plist respectively.
# VITE_FIREBASE_PROJECT_ID=dr-cubie-app
# VITE_FIREBASE_API_KEY=AIzaSy...
# VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012

# ==============================================================================
# SERVER-SIDE SECRETS (SUPABASE EDGE FUNCTIONS ONLY)
# ==============================================================================
# Set these securely via Supabase CLI or Supabase Dashboard:
#   npx supabase secrets set STRIPE_SECRET_KEY=sk_test_...
#   npx supabase secrets set FIREBASE_SERVICE_ACCOUNT='{"project_id":"...","client_email":"...","private_key":"..."}'
#
# See supabase/functions/.env.example for details.
# ==============================================================================
